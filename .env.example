# FindBack Environment Configuration  (copy to .env and edit; never commit .env)

# REQUIRED in production: a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty a random key is generated once and stored in instance/.secret_key
SECRET_KEY=c92f030bca05464cddaea0e099a0f883262a0e995ccb37238555842f918c6312

DATABASE_PATH=instance/findback.sqlite
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Local development
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=1

# Robot verification: checkbox (simple UI check) | local | turnstile | recaptcha | hcaptcha
CAPTCHA_PROVIDER=checkbox

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Teacher role permissions (comma separated). Default is read-only reports overview.
# Available: students.view,students.manage,students.reset_password,reports.view_all,reports.moderate,
#            claims.review,private.view,audit.view,staff.manage
TEACHER_PERMISSIONS=reports.view_all

# Only used by seed.py (otherwise a random one is printed once)
SEED_ADMIN_USERNAME=codertheashish
SEED_ADMIN_PASSWORD=codertheashish12345
